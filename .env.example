# Copy to .env.local and fill in real values.
# These are never committed — .env.local is gitignored.
# Release workflows must mirror these values into GitHub Actions secrets:
# - VITE_SENTRY_DSN
# - SENTRY_DSN (same value as VITE_SENTRY_DSN for Rust-side crash reporting)
# - VITE_POSTHOG_KEY
# - VITE_POSTHOG_HOST

# Sentry DSN (https://sentry.io → Project → Settings → Client Keys)
VITE_SENTRY_DSN=

# PostHog (https://posthog.com → Project → Settings → Project API Key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Lara CLI (https://github.com/translated/lara-cli)
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# Optional Vite dev-server listening settings.
# ARTEMIS_HOST defaults to localhost; set 0.0.0.0 to allow access from other devices.
# ARTEMIS_PORT defaults to 5202 for Tauri dev compatibility.
ARTEMIS_HOST=localhost
ARTEMIS_PORT=5202

# Optional standalone web password gate.
# Leave unset/blank to run Artemis without password protection.
# Set in .env.local or the deployment environment before starting/building Vite.
ARTEMIS_PASSWORD=
