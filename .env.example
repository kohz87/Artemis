# Copy to .env.local and fill in real values.
# These are never committed — .env.local is gitignored.

# Optional telemetry settings.
# Sentry DSN: https://sentry.io → Project → Settings → Client Keys
VITE_SENTRY_DSN=

# PostHog: https://posthog.com → Project → Settings → Project API Key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Lara CLI localization: https://github.com/translated/lara-cli
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# Vite frontend listener.
# ARTEMIS_HOST defaults to localhost; set 0.0.0.0 to allow access from other devices.
# ARTEMIS_PORT defaults to 5202.
ARTEMIS_HOST=localhost
ARTEMIS_PORT=5202

# Standalone local vault API/auth listener used by pnpm dev.
# The Vite frontend proxies /api/vault and /api/auth to this server.
ARTEMIS_API_HOST=127.0.0.1
ARTEMIS_API_PORT=5302

# Optional default root for filesystem-backed web vaults.
# When set, this also scopes the vault API whitelist unless ARTEMIS_ALLOWED_VAULT_ROOTS is set.
# ARTEMIS_WEB_VAULT_ROOT=~/ArtemisVault

# Optional explicit vault API whitelist. Defaults to your home directory when neither
# ARTEMIS_ALLOWED_VAULT_ROOTS nor ARTEMIS_WEB_VAULT_ROOT is set. Separate multiple
# roots with ':' on Unix/macOS or ';' on Windows.
# ARTEMIS_ALLOWED_VAULT_ROOTS=~/notes:~/work-notes

# Optional git binary and fallback author for local vault git operations.
ARTEMIS_GIT_BINARY=git
ARTEMIS_GIT_AUTHOR_NAME=Artemis Web
ARTEMIS_GIT_AUTHOR_EMAIL=artemis@localhost

# Optional standalone web password gate.
# Leave unset/blank to run Artemis without password protection.
ARTEMIS_PASSWORD=
ARTEMIS_AUTH_USERNAME=artemis
ARTEMIS_AUTH_EMAIL=
ARTEMIS_SESSION_SECRET=
ARTEMIS_SESSION_TTL_SECONDS=2592000
